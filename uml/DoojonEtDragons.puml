            }


        }

        package armes {

            interface Arme <<interface>> {
                +getNom():String;
                +getDegats():Integer
                +getPortee():Integer
            }

            class ArmeCourante implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeCourante(nom:String, portee:Integer, degats:De):ArmeCourante

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer

            }
            ArmeCourante "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

            class ArmeGuerre implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeGuerre(nom:String, portee:Integer, degats:De):ArmeGuerre

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer
            }

            ArmeGuerre "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

            class ArmeDistance implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeDistance(nom:String, degats:De, portee:Integer):ArmeDistance

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer
            }

            ArmeDistance "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

        }
    }
    package personnages
    {
        abstract class Entite <<abstract>> {
            -m_x:Integer
            -m_y:Integer

            + {abstract} attaquer(Entite entite):Boolean
            + {abstract} getPvs():Integer
            + {abstract} getForce():Integer
            + {abstract} getDexterite():Integer
            + {abstract} getInitiative():Integer
            + {abstract} estAttaquePar(Monstre monstre):Boolean
            + {abstract} estAttaquePar(Personnage perso):Boolean

            +getX():Integer
            +getY():Integer
            +setPosition(x:Integer, y:Integer)
        }

        package perso {
            class Personnage extends gameContent.personnages.Entite {
                -m_nom:String

                +<<create>> Personnage(nom:String, race:Race, classe:Classe):Personnage

                +getNom():String
                +getInventaire():Armurerie
                +getCaracteristiques():CaracteristiquePersonnage
                +getPvs():Integer
                +getForce():Integer
                +getDexterite:Integer
                +getInitiative:Integer
                +getVitesse():Integer
                +getArmeEquipee:Arme
                +getArmureEquipee:Armure
                +getDegats():Integer

                +setCaracteristiques(CaracteristiquePersonnage caracteristiques)
                +setEquipementArme(Arme arme)
                +setEquipementArmure(Armure armure)
                +setInventaire(Armurerie inventaire)
                +attaquer(entite:Entite):Boolean
                +estAttaquePar(agresseur:Monstre):Boolean
                +estAttaquePar(agresseur:Personnage):Boolean

            }

            Personnage "1" *--> "1..*-m_race" gameContent.personnages.perso.race.Race
            Personnage "1" *--> "1..*-m_classe" gameContent.personnages.perso.classe.Classe
            Personnage "1" *--> "1-m_caracteristique" gameContent.personnages.perso.CaracteristiquePersonnage
            Personnage "1" *--> "1-m_inventaire" gameContent.items.Armurerie
            Personnage "1" *--> "1-m_equipement" gameContent.items.Equipement
            Personnage "1..*" *--> "1-m_attaque" gameContent.personnages.perso.AttaquePersonnage


            class AttaquePersonnage implements gameContent.personnages.Attaque {
                -m_degats:Integer

                +<<create>> AttaquePersonnage():AttaquePersonnage

                +getDegats():Integer
            }

            AttaquePersonnage .> De : <<use>>

            class CaracteristiquePersonnage extends gameContent.personnages.Caracteristique {
                -m_vitesse:Integer

                +<<create>> CaracteristiquePersonnage(pv:Integer, force:Integer, dexterite:Integer, initiav=tive:Integer, vitesse:Integer):CaracteristiquePersonnage

                +getVitesse():Integer
                +modifyVitesse(vitesse:Integer)
                +bonusVitesse(bonus:Integer)
            }



                package race{
                    abstract class Race <<abstract>>{
                        -m_nom:String

                        +<<create>> Race(nom:String, pv:Integer, force:Integer, dexterite:Integer, vitesse:Integer, initiative:Integer):Race

                        +getCaracteristiques():CaracteristiquePersonnage
                        +getNom:String

                    }
                    class Elfe extends gameContent.personnages.perso.race.Race {
                        +<<create>> Elfe()
                    }
                    class Halfelin extends gameContent.personnages.perso.race.Race {
                        +<<create>> Halfelin()
                    }
                    class Humain extends gameContent.personnages.perso.race.Race {
                        +<<create>> Humain()
                    }
                    class Nain extends gameContent.personnages.perso.race.Race {
                        +<<create>> Nain()
                    }
                    Humain --|> Race
                    Nain --|> Race
                    Elfe --|> Race
                    Halfelin --|> Race
                }

                Race "1" *--> "1-m_caracteristique" gameContent.personnages.perso.CaracteristiquePersonnage : possède >

                package classe{
                    interface Classe <<interface>> {

                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie

                        +modifyArmurerie():Armurerie
                    }



                    class Clerc implements gameContent.personnages.perso.classe.Classe {
                        -m_nom:String
                        -m_pvs:Integer

                        +<<create>> Clerc():Clerc

                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie

                        +modifyArmurerie():Armurerie
                    }

                    Clerc "1" o--> "1-m_armurerie" gameContent.items.Armurerie: possède une >


                    class Guerrier implements gameContent.personnages.perso.classe.Classe {
                        -m_nom:String
                        -m_pvs:Integer

                        +<<create>> Guerrier():Guerrier

                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie

                        +modifyArmurerie():Armurerie
                    }

                    Guerrier "1" o--> "1-m_armurerie" gameContent.items.Armurerie: possède une >


                    class Magicien implements gameContent.personnages.perso.classe.Classe {
                        -m_nom:String
                        -m_pvs:Integer

                        +<<create>> Magicien():Magicien

                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie

                        +modifyArmurerie():Armurerie
                    }

                    Magicien "1" o--> "1-m_armurerie" gameContent.items.Armurerie: possède une >


                    class Roublard implements gameContent.personnages.perso.classe.Classe {
                        -m_nom:String
                        -m_pvs:Integer

                        +<<create>> Roublard():Roublard

                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie

                        +modifyArmurerie():Armurerie
                    }

                    Roublard "1" o--> "1-m_armurerie" gameContent.items.Armurerie: possède une >

                }
        }


        abstract class Caracteristique <<abstract>> {
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_initiative:Integer

            +<<create>> Caracteristique(pv:Integer, force:Integer, dexterite:Integer, initiative:Integer):Caracteristique

            +getPv():Integer
            +getForce():Integer
            +getDexterite():Integer
            +getInitiative():Integer

            +modifyPvs(pv:Integer)
            +modifyForce(force:Integer)
            +modifyDexterite(dexterite:Integer)
            +modifyInitiative(init:Integer)

            +bonusPvs(bonus:Integer)
            +bonusForce(bonus:Integer)
            +bonusDexterite(bonus:Integer)
            +bonusInitiative(bonus:Integer)
        }

        interface Attaque <<interface>> {
            +getDegats():Integer
        }






    package monstre {

        class Monstre extends gameContent.personnages.Entite {

            +<<create>> Monstre(carac:CaracteristiqueMonstre, espece:Espece, attaque:Attaque):Monstre
            +<<create>> Monstre(carac:CaracteristiqueMonstre, attaque:Attaque):Monstre
            +<<create>> Monstre(carac:CaracteristiqueMonstre):Monstre

            +getEspece():String
            +getAttaque():Attaque
            +getCaracteristiques():CaracteristiqueMonstre
            +getPvs():Integer
            +getForce():Integer
            +getInitiative():Integer
            +getDexterite():Integer
            +getDegats():Integer

            +attaquer(cible:Entite):Boolean
            +estAttaquePar(agresseur:Personnage):Boolean
            +estAttaquePar(agresseur:Monstre):Boolean
        }


        Monstre "1" *--> "1..*-m_espece" gameContent.personnages.monstre.Espece: est un >
        Monstre "1" *--> "1-m_caracteristique" gameContent.personnages.monstre.CaracteristiqueMonstre: possède des >
        Monstre "1" *--> "1-m_attaque" gameContent.personnages.monstre.AttaqueMonstre: attaque avec une >




        class CaracteristiqueMonstre extends gameContent.personnages.Caracteristique {
            -m_classeArmure:Integer

            +<<create>> CaracteristiqueMonstre(pv:Integer, force:Integer, dexterite:Integer, initiative:Integer, classeArmure:Integer):CaracteristiqueMonstre

            +getClassArmure():Integer
        }



        class AttaqueMonstre implements gameContent.personnages.Attaque {
            -m_nom:String
            -m_portee:Integer
            -m_degats:Integer

            +<<create>> AttaqueMonstre(nom:String, portee:Integer, degats:Integer):AttaqueMonstre

            +getNom():String
            +getPortee():Integer
            +getDegats():Integer


        }

        class Espece {
            -m_nomEspece:String
            -m_numero:Integer

            +<<create>> Espece(espece:String, num:Integer):Espece

            +getNomEspece():String
            +getNum():Integer
        }

    }


}

