@startuml
'https://plantuml.com/class-diagram
scale 0.6

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

class Main {
    + {static} main(args:String[*])
}


package gameContent
{
    package items
    {
        class Armurerie {
            +<<create>> Armurerie():Armure

            +getArmes():Arme[*]
            +getArmures():Armure[*]
            +getObjets():Items[*]

            +addArmes(armes:Arme)
            +addArmures(armures:Armure)
            +deleteArmes(arme:Arme)
            +deleteArmures(armure:Armure)
        }

        Armurerie "1" *--> "0..*-m_armes" gameContent.items.armes.Arme: contient des >
        Armurerie "1" *--> "0..*-m_armures" gameContent.items.armures.Armure: contient des >



        class Equipement {
            +<<create>> Equipement():Equipement
            +<<create>> Equipement(arme Arme, armure Armure):Equipement

            +getArme():Arme
            +getArmure():Armure

            +setArme(newWeapon:Arme):Integer
            +setArmure(newShield:Armure):Integer

        }
        Equipement "1" o--> "0..1" gameContent.items.armures.Armure: est composé de >
        Equipement "1" o--> "0..1" gameContent.items.armes.Arme: est composé de >

        interface Item <<interface>> {
            +getNom():String;
        }


        package armures {

            interface Armure <<interface>> {
                +getNom():String;
            }

            class ArmureLourde implements Armure {
                -m_nom:String

                +<<create>> ArmureLourde(nom:String):ArmureLourde
                +getNom():String
            }

            class ArmureLegere implements Armure {
                -m_nom:String

                +<<create>> ArmureLegere(nom:String):ArmureLegere
                +getNom():String

            }


        }

        package armes {

            interface Arme <<interface>> {
                +getNom():String;
                +getDegats():Integer
                +getPortee():Integer
            }

            class ArmeCourante implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeCourante(nom:String, portee:Integer, degats:De):ArmeCourante

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer

            }
            ArmeCourante "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

            class ArmeGuerre implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeGuerre(nom:String, portee:Integer, degats:De):ArmeGuerre

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer
            }

            ArmeGuerre "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

            class ArmeDistance implements Arme {
                -m_nom:String
                -m_portee:Integer

                +<<create>> ArmeDistance(nom:String, degats:De, portee:Integer):ArmeDistance

                +getNom():String
                +getDegats():Integer
                +getPortee():Integer
            }

            ArmeDistance "1" o--> "1-m_degats" fonctionnement.de.De: inflige les dégâts d'un lancer de >

        }
    }
    package personnages
    {
        abstract class Entite <<abstract>> {
            + {abstract} attaquer(Entite entite):Boolean
            +seDeplacer();
            + {abstract} getPvs():Integer
            + {abstract} getForce():Integer
            + {abstract} getDexterite():Integer
            + {abstract} getInitiative():Integer
            + {abstract} estAttaquePar(Monstre monstre):Boolean
            + {abstract} estAttaquePar(Personnage perso):Boolean
        }

        package perso {
            class Personnage extends gameContent.personnages.Entite {
                -m_nom:String
                +<<create>> Personnage()
                +getNom():String
                +getInventaire():Inventaire
                +getCaracteristiquesPerso:CaracteristiquePersonnage
                +getPvs():Integer
                +getForce():Integer
                +getDexterite:Integer
                +getInitiative:Integer
                +get
                +setCaracteristiques(CaracteristiquePersonnage caracteristiques):void
                +setEquipementArme(Arme arme):void
                +setEquipementArmure(Armure armure):void
                +setInventaire(Armurerie inventaire):void
                +attaquer(Monstre)
            }
            class AttaquePersonnage implements gameContent.personnages.Attaque {
                -m_degats:Integer
                +<<create>> AttaquePersonnage()
                +getDegats():Integer
            }

            class CaracteristiquePersonnage {
                -m_vitesse:Integer
                +<<create>> CaracteristiquePersonnage()
                +getVitesse():Integer
                +modifyVitesse(vitesse:Integer):void
                +bonusVitesse(bonus:Integer):void
            }

                Personnage "1" --> "1"race.Race : appartient à >
                Personnage "1"--> "1"classe.Classe : est >
                Personnage "1"*--> "1"CaracteristiquePersonnage : possède des >
                Personnage "1"--> "1"gameContent.items.Armurerie:possède >
                Personnage "1"--> "1"gameContent.items.Equipement:possède >
                Personnage "1"--> "1"gameContent.personnages.perso.AttaquePersonnage : a une >

                package race{
                    abstract class Race <<abstract>>{
                        +<<create>> Race()
                        -m_type:String
                    }
                    class Elfe {
                    +<<create>> Elfe()
                    }
                    class Halfelin {
                    +<<create>> Halfelin()
                    }
                    class Humain {
                    +<<create>> Humain()
                    }
                    class Nain {
                    +<<create>> Nain()
                    }
                    Humain --|> Race
                    Nain --|> Race
                    Elfe --|> Race
                    Halfelin --|> Race
                }
                Race "1" *--> "1-m_caracteristique" gameContent.personnages.perso.CaracteristiquePersonnage : possède >

                package classe{
                    abstract class Classe <<abstract>> {
                        +<<create>> Classe()
                        #m_nom:String
                        #m_pvs:Integer
                        +getPvs():Integer
                        +getNom():String
                        +getArmurerie():Armurerie
                    }
                    class Clerc {
                        +<<create>> Clerc()
                    }
                    class Guerrier {
                        +<<create>> Guerrier()
                    }
                    class Magicien {
                        +<<create>> Magicien()
                    }
                    class Roublard {
                        +<<create>> Roublard()
                    }
                    Classe "1" --> "1"gameContent.items.Armurerie
                    Clerc --|> Classe
                    Guerrier --|> Classe
                    Magicien --|> Classe
                    Roublard --|> Classe

                }
        }





        gameContent.personnages.perso.CaracteristiquePersonnage --|> Caracteristique
        gameContent.personnages.monstre.CaracteristiqueMonstre --|> Caracteristique



        abstract class Caracteristique <<abstract>> {
            +<<create>> Caracteristique()
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_initiative:Integer
            +getPv():Integer
            +getForce():Integer
            +getDexterite():Integer
            +getInitiative():Integer
        }

        interface Attaque <<interface>> {
            +getDegats():Integer
        }



    package monstre {

        class Monstre extends gameContent.personnages.Entite {
            +<<create>> Monstre():Monstre
            -m_espece:String
            -m_numero:Integer
            +getEspece():String
            +getNumero():Integer
            +attaquer():Integer
        }

        class CaracteristiqueMonstre {
            -m_classeArmure:Integer
            +getClassArmure():Integer
        }

        Monstre "1" o--> "1-m_caracteristique" gameContent.personnages.monstre.CaracteristiqueMonstre
        'Attaque "1" o--> "1-m_caracteristique" gameContent.personnages.monstre.AttaqueMonstre


        class AttaqueMonstre implements gameContent.personnages.Attaque {
            -m_nom:String
            -m_portee:Integer
            -m_degats:Integer
            +getNom():String
            +getPortee():Integer
            +getDegats():Integer
        }

    }


}

}





package fonctionnement {

    package affichage{
        class Affichage {
            + {static} afficher(message:String)
            + {static} afficherErreur(message:String)
            + {static} afficherMap(carte:Map)
            + {static} afficherLigneMap(largeur:Integer)
            + {static} afficherLigneLettreMap(largeur:Integer)
            + {static} afficherTour(tour:Integer, perso:Personnage, carte:Map)
            + {static} scanString():String
            + {static} scanInt():Integer
            + {static} afficherInventaire(perso:Personnage)
            + {static} afficherAction(actions:String[*])
        }

        class AfficherDsMonstre {
            + {static} afficherMonstreVaincu()
            + {static} afficherPvRestantsMonstre(pvRestants:Integer)
        }

        class AfficherDsPersonnage {
            + {static} afficherPersonnageVaincu()
            + {static} afficherPvRestantsPerso(pvRestants:Integer)
        }

    }

    package de {
        class De {
            -m_faces:Integer
            -m_nbdedes:Integer
            +<<create>> De(nbDes:Integer, faces:Integer):De
            +lancerDe():Integer
            +toString():String
        }
    }
    package mdj {
        class Map{
            -m_nbJoueurs:Integer
            -m_longueur:Integer
            -m_largeur:Integer
            +<<create>> Map(longueur:Integer, largeur:Integer, nbJoueurs:Integer, joueurs:Personnage[*]):Map
            +<<create>> Map(nbJoueurs:Integer, joueurs:Personnage[*]):Map
            +demanderMap()
            +redemanderMap()
            +initMap()
            +createMap()
            +createRandomMap()
            +getCarte():Integer[15:25]
            +getLongueur():Integer
            +getLargeur():Integer
        }

        'Des coordonnées n'existent pas sans carte ; 1 carte a 1x des coordonnées, et les coordonnées ne sont associées qu'à 1 carte
        Map "1" *--> "1-m_carte" fonctionnement.coordonnees.Coordonnees: belongs to >

        'Perso existe sans carte ; map peut avoir 0 perso mais perso peut qu'etre sur 1 map
        Map "0..*" o--> "1-m_joueurs" gameContent.personnages.Personnage: is part of >

        class Mdj{
            -m_nbJoueurs:Integer
            -m_nbMonstres:Integer
            -m_nbTresors:Integer

            +<<create>> Mdj():Mdj

            +getNbJoueurs():Integer
            +getJoueurs():Personnage[*]
            +getMap():Map

            +chooseRace():Race
            +chooseClasse():Classe
            +mdjMapDimensions():Map
            +tours()
            +verifyMorts():Boolean
        }

        Mdj "0" *--> "1-m_map" fonctionnement.mdj.Map: possède une >
        Mdj "0" o--> "1..*-m_joueurs" gameContent.personnages.Personnage: crée des >
        Mdj "0" o--> "1..*-m_monstres" gameContent.personnages.monstre.Monstre: crée des >
        Mdj "0" o--> "1..*-m_tresors" gameContent.items.Armurerie: crée des >


        class Tour {
            -m_tour:Integer
            -m_nbActions:Integer
            -m_actions:String[*]
            -m_finTour:Boolean

            +<<create>> Tour():Tour
            +<<create>> Tour(pers:Personnage, tour:Integer, map:Map):Tour

            +jouerTour()
            +choisirEquipement()

            +getActions():String[*]
        }

        Tour "0" o--> "1-m_perso" gameContent.personnages.Personnage: fait jouer un >
        Tour "1" o--> "1-m_map" fonctionnement.mdj.Map: est réalisé sur une >


    }

    package coordonnees {
        abstract class Coordonnees <<abstract>> {
            -m_x:Integer
            -m_y:Integer
            -m_affichage:Char[*]
            +<<create>> Coordonnes(x:Integer, y:Integer, affichage;Char[*]):Coordonnees
            +getX():Integer
            +getY():Integer
            +getAffichage():String
            +setX(newX:Integer):Integer
            +setY(newY:Integer):Integer
            +toString():String
        }

        class CoordonneesCaseVide extends Coordonnees {
            +<<create>> CoordonneesCaseVide(x:Integer, y:Integer):CoordonneesCaseVide
        }

        class CoordonneesItem extends Coordonnees {
            +<<create>> CoordonneesItem(x:Integer, y:Integer):CoordonneesItem
        }
        CoordonneesItem "1" o--> "1-m_item" gameContent.items.Item: is part of >

        class CoordonneesMonstre extends Coordonnees {
            +<<create>> CoordonneesMonstre(x:Integer, y:Integer):CoordonneesMonstre
        }
        CoordonneesMonstre "1" *--> "1-m_monstre" gameContent.personnages.monstre.Monstre: belongs to >

        class CoordonneesObstacle extends Coordonnees {
            +<<create>> CoordonneesObstacle(x:Integer, y:Integer):CoordonneesObstacle
        }

        class CoordonneesPersonnage extends Coordonnees {
            +<<create>> CoordonneesPersonnage(x:Integer, y:Integer, personnage:Personnage):CoordonneesPersonnage
        }
        CoordonneesPersonnage "1" *--> "1-m_personnage" gameContent.personnages.Personnage: belongs to >
    }
}
@enduml