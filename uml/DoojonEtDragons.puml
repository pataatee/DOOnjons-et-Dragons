@startuml
'https://plantuml.com/class-diagram
scale 1

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package gameContent
{
    package personnages
    {
        class Personnage {
            +<<create>> Personnage()
            -m_nom:String
        }
        Personnage --> race
        Personnage --> classe
        Personnage --> Caracteristiques
        Personnage --> gameContent.items.Armurerie
        Personnage --> gameContent.items.Equipement

        package race{
            abstract class Race <<abstract>>{
                +<<create>> race()
                -m_type:String
            }
            class Elfe {
            }
            class Halfelin {
            }
            class Humain {
            }
            class Nain {
            }
            Humain --|> Race
            Nain --|> Race
            Elfe --|> Race
            Halfelin --|> Race
        }
        Race --> Caracteristiques

        class Caracteristiques {
            +<<create>> Caracteristiques()
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_vitesse:Integer
            -m_initiative:Integer
        }
        package classe{
            abstract class Classe <<abstract>> {
                +<<Create>> Classe()
                -m_nom:String
                -m_pvs:Integer
            }
            class Clerc {
            }
            class Guerrier {
            }
            class Magicien {
            }
            class Roublard {
            }
            Clerc --|> Classe
            Guerrier --|> Classe
            Magicien --|> Classe
            Roublard --|> Classe
            Classe --> gameContent.items.Armurerie
        }
    }

    package items
    {

        class Armurerie {
            +<<Create>> Armurerie()

        }
        Armurerie --> shield.Armure
        Armurerie -->  weapons.Arme

        class Equipement {
            +<<Create>> Equipement()
        }
        Equipement --> shield.Armure
        Equipement --> weapons.Arme

        package shield {

            abstract class Armure <<abstract>> {
                -m_nom:String
                -m_classeArmure:Integer
            }

            class ArmureLourde {

            }

            class Armurelegere {

            }
            Armurelegere --|> Armure
            ArmureLourde --|> Armure

        }

        package weapons {

            abstract class Arme <<abstract>> {
                -m_nom:String
                -m_degat:Integer
                -m_portee:Integer
            }

            class ArmeCourante {

            }

            class ArmeGuerre {

            }

            class ArmeDistance {

            }
            ArmeCourante --|> Arme
            ArmeDistance --|> Arme
            ArmeGuerre --|> Arme

        }






    }
}

package de {
    class De {
        -m_faces
        -m_nbdedes
        +<<Create>> De(int, int):De
        +lancerde():int
    }
}
package mdj {
    class Map{
    }
}

@enduml