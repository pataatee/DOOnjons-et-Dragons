@startuml
'https://plantuml.com/class-diagram
scale 0.5


skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package gameContent
{
    package personnages
    {
        class Personnage {
            +<<create>> Personnage()
            -m_nom:String
        }

        Personnage "1" o--> "1-m_caracteristique" gameContent.personnages.Caracteristique : possède >
        Personnage "1" *--> "1..*-m_inventaire" gameContent.items.Armurerie : possède >
        Personnage "1" *--> "1-m_equipement" gameContent.items.Equipement : possède >
        Personnage "1" o--> "1-m_equipement" gameContent.personnages.race.Race : est un.e >
        Personnage "1" o--> "1-m_classe" gameContent.personnages.classe.Classe : est un.e >

        package race {

            abstract class Race <<abstract>> {
                +<<create>> Race()
                -m_type:String
            }
            Race "1" o--> "1-m_caracteristique" gameContent.personnages.Caracteristique : possède >

            class Elfe {

            }

            class Halfelin {

            }

            class Humain {

            }

            class Nain {

            }

            Humain --|> Race
            Nain --|> Race
            Elfe --|> Race
            Halfelin --|> Race

        }


        package classe {

            interface Classe <<interface>> {
                +<<Create>> Classe()
                -m_
            }
            Classe "1" o--> "1-m_caracteristique" gameContent.personnages.Caracteristique : possède des >

            class Clerc {

            }

            class Guerrier {

            }

            class Magicien {

            }

            class Roublard {

            }

            Clerc --|> Classe
            Guerrier --|> Classe
            Magicien --|> Classe
            Roublard --|> Classe
            Classe --> gameContent.items.Armurerie

        }

        class Caracteristique {
            +<<create>> Caracteristique()
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_vitesse:Integer
            -m_initiative:Integer
        }





    }

    package items
    {

        class Armurerie {
            +<<Create>> Armurerie():Armurerie
        }

        package shield {

            class Armure {
                -m_nom:String
                -m_
            }

            class Lourde extends Armure {

            }

            class Legere extends Armure {

            }

        }

        package weapons {

            abstract class Arme <<abstract>> {
                -m_nom:String
                -m_degat:Integer
                -m_portee:Integer
            }

            class CouranteCaC extends Arme {
                -m_type:Type

            }

            class GuerreCaC extends Arme {

            }

            class Distance extends Arme {

            }

            Arme "1" o--> "0..*-m_armes" Armurerie : est contenue dans >
            Armure "1" o--> "0..*m_armure" Armurerie : est contenue dans >



        }

        class Equipement {
            -m_arme:Arme
            -m_armure:Armure
        }




    }
}

package fontionnement {

    class Des {

    }

    package affichage {
    }

}
@enduml