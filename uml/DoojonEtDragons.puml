class Main {
    + {static} main(args:String[*])
}


package gameContent
{
    package items
    {
        class Armurerie {
            +<<create>> Armurerie():Armure

            +getArmes():Arme[*]
            +getArmures():Armure[*]
            +getObjets():Items[*]

            +addArmes(armes:Arme)
            +addArmures(armures:Armure)
            +deleteArmes(arme:Arme)
            +deleteArmures(armure:Armure)
        }

        Armurerie "1" *--> "0..*-m_armes" gameContent.items.armes.Arme: contient des >
        Armurerie "1" *--> "0..*-m_armures" gameContent.items.armures.Armure: contient des >



        class Equipement {
            +<<create>> Equipement():Equipement
            +<<create>> Equipement(arme Arme, armure Armure):Equipement

            +getArme():Arme
            +getArmure():Armure

            +setArme(newWeapon:Arme):Integer
            +setArmure(newShield:Armure):Integer

        }
        Equipement "1" o--> "0..1" gameContent.items.armures.Armure: est composé de >
        Equipement "1" o--> "0..1" gameContent.items.armes.Arme: est composé de >

        interface Item <<interface>> {
            +getNom():String;
        }


        package armures {

            interface Armure <<interface>> {
                +getNom():String;
                +getClasseArmure():Integer
            }

            class ArmureLourde implements Armure {
                -m_nom:String
                -m_classeArmure:Integer

                +<<create>> ArmureLourde(nom:String):ArmureLourde

                +getNom():String
                +getClasseArmure():Integer
            }

            class ArmureLegere implements Armure {
                -m_nom:String
                -m_classeArmure:Integer

                +<<create>> ArmureLegere(nom:String):ArmureLegere

                +getNom():String
