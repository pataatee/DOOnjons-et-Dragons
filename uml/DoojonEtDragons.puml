@startuml
'https://plantuml.com/class-diagram
scale 1

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package gameContent
{
    package personnages
    {
        class Personnage {
            +<<create>> Personnage()
            -m_nom:String
        }
        Personnage --> race.Race
        Personnage --> classe.Classe
        Personnage --> Caracteristiques
        Personnage --> gameContent.items.Armurerie
        Personnage --> gameContent.items.Equipement

        package race{
            abstract class Race <<abstract>>{
                +<<create>> Race()
                #m_type:String
            }
            class Elfe {
            }
            class Halfelin {
            }
            class Humain {
            }
            class Nain {
            }
            Humain --|> Race
            Nain --|> Race
            Elfe --|> Race
            Halfelin --|> Race
        }
        Race --> Caracteristiques

        class Caracteristiques {
            +<<create>> Caracteristiques()
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_vitesse:Integer
            -m_initiative:Integer
        }
        package classe{
            abstract class Classe <<abstract>> {
                +<<Create>> Classe()
                #m_nom:String
                #m_pvs:Integer
            }
            class Clerc {
            }
            class Guerrier {
            }
            class Magicien {
            }
            class Roublard {
            }
            Clerc --|> Classe
            Guerrier --|> Classe
            Magicien --|> Classe
            Roublard --|> Classe
            Classe --> gameContent.items.Armurerie
        }
    }

    package items
    {

        class Armurerie {
            -m_armes:List<Arme>
            -m_armures:List<Armure>
            +<<Create>> Armurerie()
            +getM_armes():List<Arme>
            +getM_armures():List<Armure>
            +addM_armes(Arme)
            +addM_armures(Armure)
        }
        Armurerie --> shield.Armure
        Armurerie -->  weapons.Arme

        class Equipement {
            +<<Create>> Equipement()
        }
        Equipement --> shield.Armure
        Equipement --> weapons.Arme

        package shield {

            abstract class Armure <<abstract>> {
                #m_nom:String
                #m_classeArmure:Integer
            }

            class ArmureLourde {

            }

            class Armurelegere {

            }
            Armurelegere --|> Armure
            ArmureLourde --|> Armure

        }

        package weapons {

            abstract class Arme <<abstract>> {
                #m_nom:String
                #m_degat:Integer
                #m_portee:Integer
            }

            class ArmeCourante {

            }

            class ArmeGuerre {

            }

            class ArmeDistance {

            }
            ArmeCourante --|> Arme
            ArmeDistance --|> Arme
            ArmeGuerre --|> Arme

        }






    }
}

package de {
    class De {
        -m_faces
        -m_nbdedes
        +<<Create>> De(int, int):De
        +lancerde():int
    }
}
package mdj {
    class Map{
    -m_map:Integer[15][25]
    +createRandomMap():Integer[15][25]
    +getM_map():Integer[15][25]
    +createOwnMap():Integer[15][25]
    }
    class Mdj{
    -m_nbJoueurs:Integer
    -m_joueurs:Personnage[m_nbJoueurs]
    -m_tour:Integer
    +<<Create>> Mdj()
    +getM_nbJoueurs():Integer
    +getM_joueurs():Personnage[m_nbJoueurs]
    +getM_map():Map
    +chooseRace():Race
    +chooseClasse():Classe
    +createJoueur():Personnage
    }
    Mdj o--> De
    Mdj --> Map
    Mdj --> gameContent.personnages.Personnage
}

@enduml