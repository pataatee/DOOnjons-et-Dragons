@startuml
'https://plantuml.com/class-diagram
scale 1

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package gameContent
{
    package personnages
    {
        class Personnage {
            +<<create>> Personnage()
            -m_nom:String
            -m_race:Race
            -m_caracteristique:Caracteristique
            -m_inventaire:List<Armurerie>
            -m_equipement:Equipement
        }

        class Race {
            +<<create>> race()
            -m_type:String
            -m_caracteristique:Caracteristique
        }

        class Caracteristique {
            +<<create>> Caracteristique()
            -m_pv:Integer
            -m_force:Integer
            -m_dexterite:Integer
            -m_vitesse:Integer
            -m_initiative:Integer
        }

        class Classe {
            +<<Create>> Classe()
            -m_nom:String
            -m_caracteristique:Caracteristique
        }


    }

    package items
    {

        class Armurerie {
            +<<Create>> Armurerie():Armurerie
            -m_armes:List<Armes>
            -m_armures:List<Armures>
        }

        package shield {

            class Armure {
                -m_nom:String
                -m_
            }

            class lourde {

            }

            class legere {

            }

        }

        package weapons {

            abstract class Arme <<abstract>> {
                -m_nom:String
                -m_degat:Integer
                -m_portee:Integer
            }

            class couranteCaC {

            }

            class guerreCaC {

            }

            class distance {

            }

        }






    }
}

package fontionnement {

    class Des {

    }

}
@enduml